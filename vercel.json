{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/mas/browser",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/registrations.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/members.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/membership-renewals.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/membership-renewals/[id].mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/contact-details-updates.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/contact-details-updates/[id].mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/contact-details-updates/clear-schedule.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/registrations/[id].mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/registrations/[id]/email.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/admin/registrations/clear-schedule.mjs": {
      "includeFiles": "dist/mas/**"
    },
    "api/cron/clear-registrations.mjs": {
      "includeFiles": "dist/mas/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/clear-registrations",
      "schedule": "0 3 * * *"
    }
  ]
}
